# Copiar a .env (misma carpeta) y llenar. .env está en .gitignore: nunca subir secretos reales.
# Lo leen docker compose Y cada servicio cuando se corre desde el IDE (spring.config.import).

# Contraseña de "sa". SQL Server rechaza las débiles: 8+ caracteres con mayúscula, minúscula, número y símbolo.
DB_PASSWORD=ChangeMe_2026!
DB_NAME=LavaRapido
DB_USERNAME=sa
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=LavaRapido;encrypt=true;trustServerCertificate=true

# Llave de firma HS256 compartida por todo servicio que verifique tokens (ADR-006). Mínimo 32 bytes.
# Se genera con:  openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:4200
