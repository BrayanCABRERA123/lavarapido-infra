# Copiar a .env (misma carpeta) y llenar. .env está en .gitignore: nunca subir secretos reales.
# Lo leen docker compose Y cada servicio cuando se corre desde el IDE (spring.config.import).

# Contraseña de "sa". SQL Server rechaza las débiles: 8+ caracteres con mayúscula, minúscula, número y símbolo.
DB_PASSWORD=ChangeMe_2026!
DB_NAME=LavaRapido
DB_USERNAME=sa
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=LavaRapido;encrypt=true;trustServerCertificate=true

# Llave de firma HS256 compartida por todo servicio que verifique tokens (ADR-006). Mínimo 32 bytes.
# Se genera con:  openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:4200

# ─── Correo (código de recuperación de contraseña) ─────────────────────────────
# MAIL_ENABLED=false -> el código sale en la consola del security-service.
# MAIL_ENABLED=true  -> se envía por correo. Elige UNA de las dos opciones de abajo.

MAIL_ENABLED=true

# Opción A — Mailpit (recomendada para desarrollo). No llega a nadie de verdad: ver los
# correos en http://localhost:8025. Se levanta con `docker compose up -d`.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dev
MAIL_PASSWORD=dev
MAIL_FROM=LavaRápido <no-reply@lavarapido.local>

# Opción B — Gmail (el código llega al correo real del usuario). Requiere verificación en dos
# pasos y una "contraseña de aplicación" de 16 letras: https://myaccount.google.com/apppasswords
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@dominio.com
# MAIL_PASSWORD=la-contrasena-de-aplicacion-sin-espacios
# MAIL_FROM=LavaRápido <tu-correo@dominio.com>
# Solo si corres los servicios con `--profile app`: host del correo visto desde Docker.
# MAIL_DOCKER_HOST=smtp.gmail.com
