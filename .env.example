# Copiar a .env (misma carpeta) y llenar. .env está en .gitignore: nunca subir secretos reales.
# Lo leen docker compose Y cada servicio cuando se corre desde el IDE (spring.config.import).

# Contraseña de "sa". SQL Server rechaza las débiles: 8+ caracteres con mayúscula, minúscula, número y símbolo.
DB_PASSWORD=ChangeMe_2026!
DB_NAME=LavaRapido
DB_USERNAME=sa
# 14330, no 1433: si tienes una instancia de SQL Server nativa en Windows, se queda con el
# 1433 del host y el contenedor nunca recibe la conexión aunque "docker ps" diga que sí.
DB_URL=jdbc:sqlserver://localhost:14330;databaseName=LavaRapido;encrypt=true;trustServerCertificate=true

# Llave de firma HS256 compartida por todo servicio que verifique tokens (ADR-006). Mínimo 32 bytes.
# Se genera con:  openssl rand -base64 48
JWT_SECRET=

CORS_ALLOWED_ORIGINS=http://localhost:4200

# ─── URLs de los vecinos (llamadas REST entre servicios, ADR-004) ─────────────
# Todos tienen default en su application.yml; se exponen aquí para no depender de
# puertos hardcodeados cuando algún servicio corre fuera del IDE.
# SECURITY_SERVICE_URL=http://localhost:3001/api/v1     # la lee customer-service (perfil por REST)
# SECURITY_SERVICE_TIMEOUT=3s
# CUSTOMER_SERVICE_URL=http://localhost:3002/api/v1     # la lee booking-service (validación del vehículo)
# CUSTOMER_SERVICE_TIMEOUT=3s
# BOOKING_ZONE=America/Bogota                           # hora del lavadero que ve el cliente
# BOOKING_SLOT_MINUTES=30                               # cada cuánto se ofrece una hora de inicio
# BOOKING_MAX_DAYS_AHEAD=60                             # hasta cuántos días hacia adelante se reserva

# ─── Correo (código de recuperación de contraseña) ─────────────────────────────
# MAIL_ENABLED=false -> el código sale en la consola del security-service.
# MAIL_ENABLED=true  -> se envía por correo. Elige UNA de las dos opciones de abajo.

MAIL_ENABLED=true

# Opción A — Mailpit (recomendada para desarrollo). No llega a nadie de verdad: ver los
# correos en http://localhost:8025. Se levanta con `docker compose up -d`.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dev
MAIL_PASSWORD=dev
MAIL_FROM=LavaRápido <no-reply@lavarapido.local>

# Opción B — Gmail (el código llega al correo real del usuario). Requiere verificación en dos
# pasos y una "contraseña de aplicación" de 16 letras: https://myaccount.google.com/apppasswords
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@dominio.com
# MAIL_PASSWORD=la-contrasena-de-aplicacion-sin-espacios
# MAIL_FROM=LavaRápido <tu-correo@dominio.com>
# Solo si corres los servicios con `--profile app`: host del correo visto desde Docker.
# MAIL_DOCKER_HOST=smtp.gmail.com

# ─── RabbitMQ (eventos entre servicios, ADR-004) ────────────────────────────────
# Se levanta con `docker compose up -d`. Panel: http://localhost:15672 (mismo usuario y clave).
# MESSAGING_ENABLED=false -> los servicios funcionan sin RabbitMQ (los eventos solo van al log).
# MESSAGING_ENABLED=true  -> security publica los eventos y notification los recibe.
MESSAGING_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─── Notificaciones push (notification-service, ADR-011) ───────────────────────
# PUSH_ENABLED=false -> las push solo se escriben en el log del notification-service.
# PUSH_ENABLED=true  -> se envían con el servicio de Expo a los celulares con la app instalada.
PUSH_ENABLED=false
# Opcional: solo si en expo.dev activas "Enhanced security for push". Nunca subirlo.
# EXPO_ACCESS_TOKEN=
