# Copiar a .env (misma carpeta) y llenar. .env está en .gitignore: nunca subir secretos reales.
# Lo leen docker compose Y cada servicio cuando se corre desde el IDE (spring.config.import).

# Contraseña de "sa". SQL Server rechaza las débiles: 8+ caracteres con mayúscula, minúscula, número y símbolo.
DB_PASSWORD=<cambia-esta-contraseña>
DB_NAME=LavaRapido
DB_USERNAME=sa
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=LavaRapido;encrypt=true;trustServerCertificate=true

# Llave de firma HS256 compartida por todo servicio que verifique tokens (ADR-006). Mínimo 32 bytes.
# Se genera con:  openssl rand -base64 48
JWT_SECRET=

# Orígenes que pueden llamar al gateway desde un navegador: la web (4200) y la app móvil abierta
# en el navegador con Expo (8081). La app en el celular no usa CORS. Todos los servicios Java lo
# leen, así que al cambiarlo hay que reiniciarlos.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# ─── URLs de los vecinos (llamadas REST entre servicios, ADR-004) ─────────────
# Todos tienen default en su application.yml; se exponen aquí para no depender de
# puertos hardcodeados cuando algún servicio corre fuera del IDE.
# SECURITY_SERVICE_URL=http://localhost:3001/api/v1     # la lee customer-service (perfil por REST)
# SECURITY_SERVICE_TIMEOUT=3s
# CUSTOMER_SERVICE_URL=http://localhost:3002/api/v1     # la lee booking-service (validación del vehículo)
# CUSTOMER_SERVICE_TIMEOUT=3s
# BOOKING_SERVICE_URL=http://localhost:3003/api/v1      # la lee customer-service (¿el vehículo tiene reservas activas?, BIZ-08)
# BOOKING_ZONE=America/Bogota                           # hora del lavadero que ve el cliente
# BOOKING_SLOT_MINUTES=30                               # cada cuánto se ofrece una hora de inicio
# BOOKING_MAX_DAYS_AHEAD=60                             # hasta cuántos días hacia adelante se reserva

# ─── Cuentas demo (solo perfil dev, E-05) ─────────────────────────────────────
# security-service crea admin@gmail.com, operador@gmail.com y cliente@gmail.com con estas contraseñas.
# Vacía: esa cuenta no se crea. 8+ caracteres con mayúscula, número y símbolo. Nunca las subas a Git.
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_PASSWORD=
DEMO_CLIENT_PASSWORD=

# ─── Dominios de correo permitidos (A-01, RF-001) ─────────────────────────────
# security-service solo deja registrarse, crear usuarios y cambiar el correo con estos dominios
# (separados por comas). Por defecto: gmail.com
ALLOWED_EMAIL_DOMAINS=gmail.com

# ─── Correo (código de recuperación de contraseña) ─────────────────────────────
# MAIL_ENABLED=false -> el código sale en la consola del security-service.
# MAIL_ENABLED=true  -> se envía por correo. Elige UNA de las dos opciones de abajo.

MAIL_ENABLED=true

# Opción A — Mailpit (recomendada para desarrollo). No llega a nadie de verdad: ver los
# correos en http://localhost:8025. Se levanta con `docker compose up -d`.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=dev
MAIL_PASSWORD=dev
MAIL_FROM=LavaRápido <no-reply@lavarapido.local>

# Opción B — Gmail (el código llega al correo real del usuario). Requiere verificación en dos
# pasos y una "contraseña de aplicación" de 16 letras: https://myaccount.google.com/apppasswords
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tu-correo@dominio.com
# MAIL_PASSWORD=la-contrasena-de-aplicacion-sin-espacios
# MAIL_FROM=LavaRápido <tu-correo@dominio.com>
# Solo si corres los servicios con `--profile app`: host del correo visto desde Docker.
# MAIL_DOCKER_HOST=smtp.gmail.com

# ─── RabbitMQ (eventos entre servicios, ADR-004) ────────────────────────────────
# Se levanta con `docker compose up -d`. Panel: http://localhost:15672 (mismo usuario y clave).
# MESSAGING_ENABLED=false -> los servicios funcionan sin RabbitMQ (los eventos solo van al log).
# MESSAGING_ENABLED=true  -> security publica los eventos y notification los recibe.
MESSAGING_ENABLED=false
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ─── Notificaciones push (notification-service, ADR-011) ───────────────────────
# PUSH_ENABLED=false -> las push solo se escriben en el log del notification-service.
# PUSH_ENABLED=true  -> se envían con el servicio de Expo a los celulares con la app instalada.
PUSH_ENABLED=false
# Opcional: solo si en expo.dev activas "Enhanced security for push". Nunca subirlo.
# EXPO_ACCESS_TOKEN=

# ─── Llave entre servicios (/internal/**, ADR-011 sección 8) ───────────────────
# notification-service la usa para pedirle a security-service el correo del cliente y enviar
# por correo los avisos de reserva y los recordatorios. Vacía: esos avisos no van por correo.
# customer-service la usa para preguntarle a booking-service si un vehículo tiene reservas activas
# antes de retirarlo (BIZ-08). Vacía: no se puede retirar ningún vehículo.
# operations-service la usa para leer el primer nombre de clientes y operarios en las
# calificaciones. Vacía: las calificaciones se muestran sin nombres.
# operations-service también lee las reservas de booking-service por /internal para asignar solo
# un operario al confirmarse una reserva (RF-008) y mostrarle al cliente quién está libre (RF-010).
# Vacía: no hay asignación automática ni lista de operarios libres (el admin asigna a mano).
# También es obligatoria para que el operario inicie y termine servicios: booking solo acepta
# /api/v1/operator/bookings/** desde operations-service con esta llave (E-01).
# Para apagar solo la asignación automática: AUTO_ASSIGN_ENABLED=false
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=
# Recordatorios de reserva: con cuánta anticipación y cada cuánto se revisan
# REMINDER_LEADS=24h,1h
# REMINDER_CHECK_INTERVAL=5m

# ─── Chequeo de sesión y cierres automáticos (todas tienen valor por defecto) ──────
# api-gateway: corta el token de una sesión cerrada (logout o cuenta desactivada) preguntando a
# security-service; guarda la respuesta por token y, si security no contesta, deja pasar.
# SESSION_CHECK_ENABLED=true
# SESSION_CHECK_CACHE_TTL=30s
# SESSION_CHECK_TIMEOUT=3s
# booking-service cancela las reservas programadas que pasaron su hora de fin + el margen sin
# confirmarse. operations-service usa el mismo margen: las confirmadas sin operario quedan
# "no asistió" y las que tienen operario quedan "Por cerrar" para el administrador.
# BOOKING_EXPIRY_GRACE_MINUTES=60
# BOOKING_EXPIRY_CHECK_ENABLED=true
# BOOKING_EXPIRY_CHECK_INTERVAL=PT5M
# FOLLOW_UP_ENABLED=true
# FOLLOW_UP_INTERVAL=PT5M
# FOLLOW_UP_LOOK_BACK_DAYS=28                           # días hacia atrás (el servidor puede pasar semanas apagado)
