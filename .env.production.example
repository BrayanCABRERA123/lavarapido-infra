# Plantilla del .env del SERVIDOR (docker-compose.prod.yml). Copiar a .env.production en el
# servidor y llenar con valores NUEVOS: no reusar las contraseñas del computador de desarrollo.
# .env.production está en .gitignore: nunca se sube.

# ─── Dirección pública ─────────────────────────────────────────────────────────
# Con dominio (HTTPS automático): SITE_ADDRESS=vehiclecarwash.com  PUBLIC_URL=https://vehiclecarwash.com
# Sin dominio (solo http, con la IP del VPS): SITE_ADDRESS=:80     PUBLIC_URL=http://IP-DEL-VPS
SITE_ADDRESS=:80
PUBLIC_URL=http://IP-DEL-VPS

# ─── Base de datos ─────────────────────────────────────────────────────────────
# 8+ caracteres con mayúscula, minúscula, número y símbolo
DB_PASSWORD=
DB_NAME=LavaRapido
DB_USERNAME=sa

# ─── Llaves (generar cada una con: openssl rand -base64 48) ───────────────────
JWT_SECRET=
INTERNAL_API_KEY=

# ─── Primer administrador ─────────────────────────────────────────────────────
# La base de producción empieza vacía y el registro público solo crea clientes. Al arrancar, si no
# hay ningún administrador, security-service crea este. Si ya hay un administrador no se usa.
# Contraseña: 8+ caracteres con mayúscula, minúscula, número y símbolo.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Principal
# Cédula y celular reales del administrador (sin ellos quedan valores de relleno en su perfil)
ADMIN_DOCUMENT=
ADMIN_PHONE=

# ─── RabbitMQ (no usar guest/guest) ───────────────────────────────────────────
MESSAGING_ENABLED=true
RABBITMQ_USERNAME=lavarapido
RABBITMQ_PASSWORD=

# ─── Correo (Gmail con contraseña de aplicación) ──────────────────────────────
MAIL_ENABLED=true
MAIL_DOCKER_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=VehicleCarWash <tu-correo@gmail.com>

# ─── Push (Expo) y asignación automática ──────────────────────────────────────
PUSH_ENABLED=true
AUTO_ASSIGN_ENABLED=true
BOOKING_ZONE=America/Bogota

# ─── Opcionales: chequeo de sesión y cierres automáticos (valores por defecto) ──
# SESSION_CHECK_ENABLED=true
# SESSION_CHECK_CACHE_TTL=30s
# SESSION_CHECK_TIMEOUT=3s
# BOOKING_EXPIRY_GRACE_MINUTES=60
# BOOKING_EXPIRY_CHECK_ENABLED=true
# BOOKING_EXPIRY_CHECK_INTERVAL=PT5M
# FOLLOW_UP_ENABLED=true
# FOLLOW_UP_INTERVAL=PT5M
# FOLLOW_UP_LOOK_BACK_DAYS=28
