# Plantilla del .env del SERVIDOR (docker-compose.prod.yml). Copiar a .env.production en el
# servidor y llenar con valores NUEVOS: no reusar las contraseñas del computador de desarrollo.
# .env.production está en .gitignore: nunca se sube.

# ─── Dirección pública ─────────────────────────────────────────────────────────
# Con dominio (HTTPS automático): SITE_ADDRESS=vehiclecarwash.com  PUBLIC_URL=https://vehiclecarwash.com
# Sin dominio (solo http, con la IP del VPS): SITE_ADDRESS=:80     PUBLIC_URL=http://IP-DEL-VPS
SITE_ADDRESS=:80
PUBLIC_URL=http://IP-DEL-VPS

# ─── Base de datos ─────────────────────────────────────────────────────────────
# 8+ caracteres con mayúscula, minúscula, número y símbolo
DB_PASSWORD=
DB_NAME=LavaRapido
DB_USERNAME=sa

# ─── Llaves (generar cada una con: openssl rand -base64 48) ───────────────────
JWT_SECRET=
INTERNAL_API_KEY=

# ─── RabbitMQ (no usar guest/guest) ───────────────────────────────────────────
MESSAGING_ENABLED=true
RABBITMQ_USERNAME=lavarapido
RABBITMQ_PASSWORD=

# ─── Correo (Gmail con contraseña de aplicación) ──────────────────────────────
MAIL_ENABLED=true
MAIL_DOCKER_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=VehicleCarWash <tu-correo@gmail.com>

# ─── Push (Expo) y asignación automática ──────────────────────────────────────
PUSH_ENABLED=true
AUTO_ASSIGN_ENABLED=true
BOOKING_ZONE=America/Bogota
